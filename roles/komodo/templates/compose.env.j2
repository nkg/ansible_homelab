# {{ ansible_managed }}
# Deployed as `.env` alongside compose.yaml:
#   - docker compose reads it automatically for ${VAR} interpolation in
#     compose.yaml (Mongo root credentials)
#   - the core service also loads it via `env_file:` for its runtime env
# See https://github.com/moghtech/komodo for the full list of variables.
#
# All values are double-quoted: compose resolves ${VAR} in compose.yaml and
# would otherwise treat `$` in unquoted secrets as variable references,
# corrupting credentials while Core (reading via env_file:) would still
# get the literal value — a silent credential mismatch.

# --- DB credentials ---
# One pair of credentials, used in two places via compose ${VAR} expansion:
#   1. MONGO_INITDB_ROOT_USERNAME / MONGO_INITDB_ROOT_PASSWORD on the mongo
#      service (initialised on first start)
#   2. Komodo Core (KOMODO_DATABASE_USERNAME / KOMODO_DATABASE_PASSWORD)
# Komodo speaks MongoDB to mongo:27017 — KOMODO_DATABASE_ADDRESS is set
# inline on the core service in compose.yaml.
KOMODO_DATABASE_USERNAME="{{ komodo_db_username }}"
KOMODO_DATABASE_PASSWORD="{{ komodo_db_password }}"

# --- Core ---
KOMODO_HOST="https://{{ komodo_core_host }}"
KOMODO_TITLE="Komodo"
KOMODO_PORT="9120"

# --- Auth (local username + password) ---
# `KOMODO_INIT_ADMIN_*` only takes effect on first start (empty users
# collection). After the admin is created they're inert; safe to leave set.
KOMODO_LOCAL_AUTH="{{ komodo_local_auth | string | lower }}"
KOMODO_INIT_ADMIN_USERNAME="{{ komodo_init_admin_username }}"
KOMODO_INIT_ADMIN_PASSWORD="{{ komodo_init_admin_password }}"

# Komodo's auth rate limit applies to every auth-validating endpoint
# (including the SPA's per-page /user check), not just login POSTs.
# Defaults (5 attempts / 15s) trip a 429 bounce-loop on any page that
# fans out several authed requests on load. See role defaults for the
# reasoning behind the chosen values.
KOMODO_AUTH_RATE_LIMIT_MAX_ATTEMPTS="{{ komodo_auth_rate_limit_max_attempts }}"
KOMODO_AUTH_RATE_LIMIT_WINDOW_SECONDS="{{ komodo_auth_rate_limit_window_seconds }}"

# --- Auth / signing ---
# Komodo v2 uses Noise/Ed25519 for Core ↔ Periphery auth. Each Periphery
# generates its keypair on first start at ${root_directory}/keys/periphery.key;
# Core authenticates every handshake against KOMODO_PERIPHERY_PUBLIC_KEY,
# which is a COMMA-SEPARATED list of every trusted periphery .pub.
#
# Bootstrap a new host once: install Periphery (it generates its key),
# read the .pub, record it in SOPS as secrets.komodo.<host>_periphery_public_key,
# add it to komodo_periphery_public_keys in host_vars/komodo.yaml, then
# re-deploy Core. A key absent from this list is rejected with
# "Core failed to validate Periphery public key … is invalid".
#
# komodo_periphery_public_keys (list) is preferred; the singular
# komodo_periphery_public_key is kept as a fallback for older overrides.
{% set _ppks = (komodo_periphery_public_keys | default([])) | map('trim') | select | unique | list %}
{% if _ppks | length > 0 %}
KOMODO_PERIPHERY_PUBLIC_KEY="{{ _ppks | join(',') }}"
{% elif komodo_periphery_public_key | default('') | trim %}
KOMODO_PERIPHERY_PUBLIC_KEY="{{ komodo_periphery_public_key | trim }}"
{% endif %}
KOMODO_WEBHOOK_SECRET="{{ komodo_webhook_secret }}"
KOMODO_JWT_SECRET="{{ komodo_jwt_secret }}"

# --- Periphery (local agent on this VM) ---
KOMODO_PERIPHERY_PORT="{{ komodo_periphery_port }}"
